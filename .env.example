# ScholarLens environment variable contract (README §12 / CONTEXT.md D-09).
# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real credentials.
#
# Defaults below use in-Docker-network hostnames (neo4j, qdrant, postgres)
# since these are the values `docker compose up` actually resolves against.

# --- Neo4j (graph store) ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_neo4j

# --- Qdrant (vector store) ---
QDRANT_URL=http://qdrant:6333

# --- PostgreSQL (relational store) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=scholarlens
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=scholarlens

# --- PDF ingestion / upload (consumed starting Phase 1) ---
PDF_STORAGE_PATH=/data/pdfs
MAX_UPLOAD_SIZE_MB=50
MAX_UPLOAD_FILES=20

# --- Ingestion sources (consumed starting Phase 1) ---
# Unpaywall requires a contact email per their API usage policy.
UNPAYWALL_EMAIL=you@example.com
# Optional — Semantic Scholar works unauthenticated at a lower rate limit.
SEMANTIC_SCHOLAR_API_KEY=
# Optional — where the cached ACL Anthology .bib export lives. Defaults to
# data/acl_anthology_export.bib in code; uncomment only to override.
# ACL_ANTHOLOGY_BIB_PATH=data/acl_anthology_export.bib

# --- GROBID (Stage 2 parsing service) ---
GROBID_URL=http://grobid:8070

# --- LLM (choose exactly one provider: gemini or ollama) ---
LLM_PROVIDER=ollama
# Gemini: set LLM_PROVIDER=gemini and provide a key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
# Ollama: set LLM_PROVIDER=ollama; no API key is required for a local server.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
LLM_TIMEOUT_SECONDS=120

# --- Backend ML / retrieval configuration ---
JOINT_IE_MODEL=fastino/gliner2.5-base-v1
SPECTER2_MODEL=allenai/specter2_base
NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
QDRANT_COLLECTION=scholarlens-evidence
EMBEDDING_BATCH_SIZE=16
CLUSTER_MIN_SIZE=3
CONTRADICTION_THRESHOLD=0.75
MAX_NLI_PAIRS=1000
RETRIEVAL_ROUND_CAP=3
RETRIEVAL_TOP_N=12
REPORT_TOP_K=10

# --- Gap ranking weights ---
GAP_WEIGHT_MENTION_FREQUENCY=1.0
GAP_WEIGHT_TREND_SLOPE=1.0
GAP_WEIGHT_SOLUTION_DENSITY=1.0
GAP_WEIGHT_CITATION_IMPACT=0.2
GAP_WEIGHT_CONTRADICTION_FLAG=0.5

# Protects all endpoints except /health and OpenAPI when configured.
API_KEY=change-me
