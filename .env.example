# ScholarLens environment variable contract (README §12 / CONTEXT.md D-09).
# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real credentials.
#
# Defaults below use in-Docker-network hostnames (neo4j, qdrant, postgres)
# since these are the values `docker compose up` actually resolves against.

# --- Neo4j (graph store) ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_neo4j

# --- Qdrant (vector store) ---
QDRANT_URL=http://qdrant:6333

# --- PostgreSQL (relational store) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=scholarlens
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=scholarlens

# --- PDF ingestion / upload (consumed starting Phase 1) ---
PDF_STORAGE_PATH=/data/pdfs
MAX_UPLOAD_SIZE_MB=50

# --- Ingestion sources (consumed starting Phase 1) ---
# Unpaywall requires a contact email per their API usage policy.
UNPAYWALL_EMAIL=you@example.com
# Optional — Semantic Scholar works unauthenticated at a lower rate limit.
SEMANTIC_SCHOLAR_API_KEY=

# --- LLM (consumed starting Phase 9/10 — Mode A explanation / Mode B GraphRAG) ---
LLM_API_KEY=
