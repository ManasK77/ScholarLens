# ScholarLens environment variable contract (README §12 / CONTEXT.md D-09).
# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real credentials.
#
# Defaults below use in-Docker-network hostnames (neo4j, qdrant, postgres)
# since these are the values `docker compose up` actually resolves against.

# --- Logging / observability ---
# Root log level for the backend. INFO is what makes a pipeline run legible:
# per-stage start/complete lines with elapsed times, throttled progress, and
# the counts each stage produced. Every record carries the `run_id` of the
# `/pipeline/run` that emitted it. DEBUG adds per-paper and per-cluster detail
# and is verbose over a large corpus. Counts only — no paper text is ever
# logged. One of DEBUG, INFO, WARNING, ERROR.
# LOG_LEVEL=INFO

# --- Neo4j (graph store) ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_neo4j

# --- Qdrant (vector store) ---
QDRANT_URL=http://qdrant:6333

# --- PostgreSQL (relational store) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=scholarlens
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=scholarlens

# --- PDF ingestion / upload (consumed starting Phase 1) ---
PDF_STORAGE_PATH=/data/pdfs
MAX_UPLOAD_SIZE_MB=50

# --- Ingestion sources (consumed starting Phase 1) ---
# Unpaywall requires a contact email per their API usage policy.
UNPAYWALL_EMAIL=you@example.com
# Optional — Semantic Scholar works unauthenticated at a lower rate limit.
SEMANTIC_SCHOLAR_API_KEY=
# Optional request pacing for /collect (defaults live in app/core/config.py).
# Every arXiv / Semantic Scholar request this backend makes, retries included,
# waits its turn on one process-wide limiter per source. For arXiv that covers
# BOTH the metadata search (export.arxiv.org) and every PDF download from
# arxiv.org — including an arXiv copy Unpaywall resolves — so the two can never
# burst independently. Raising ARXIV_MIN_INTERVAL_SECONDS therefore also slows
# PDF collection: a full 10-paper arXiv run makes 11 paced requests.
# Maximum distinct papers each automatic source adds per /collect run. 1-10;
# 10 is a hard ceiling. Manual PDF uploads are not capped.
# ARXIV_MAX_RESULTS=10
# SEMANTIC_SCHOLAR_MAX_RESULTS=10
# ACL_ANTHOLOGY_MAX_RESULTS=10
# Results fetched in Semantic Scholar's single search request (1-100, never
# below its cap). Records Semantic Scholar tags Editorial / News /
# LettersAndComments / CaseReport are dropped before the cap is applied, so
# the extra results keep them from using up slots.
# SEMANTIC_SCHOLAR_REQUEST_LIMIT=20
# Minimum seconds between two requests. arXiv's terms allow at most one request
# every 3 seconds, so 3 is its floor (3-60). Semantic Scholar: 1-60.
# ARXIV_MIN_INTERVAL_SECONDS=5
# SEMANTIC_SCHOLAR_MIN_INTERVAL_SECONDS=1.5
# Retries of a 429/5xx answer. The wait before retry n is the longer of the
# server's Retry-After and BASE * 2^n; a wait above MAX ends retrying and the
# source is reported as failed for that run.
# arXiv only: a 429 with no Retry-After header is NOT retried — arXiv's live
# throttle sends none, and a retry would just add requests to a host already
# refusing them. That run makes one arXiv request, reports the source failed,
# holds arXiv back for ARXIV_BACKOFF_MAX_SECONDS, and continues with the other
# sources. 5xx, timeouts and dated 429s still use the retry budget below.
# ARXIV_NUM_RETRIES=2
# ARXIV_BACKOFF_BASE_SECONDS=10
# ARXIV_BACKOFF_MAX_SECONDS=60
# SEMANTIC_SCHOLAR_MAX_RETRIES=3
# SEMANTIC_SCHOLAR_BACKOFF_BASE_SECONDS=2
# SEMANTIC_SCHOLAR_BACKOFF_MAX_SECONDS=30
# Contact (email or URL) sent in ScholarLens's arXiv User-Agent on every arXiv
# request — metadata and PDF — as arXiv asks of automated clients. Recommended:
# it is how arXiv reaches the operator instead of silently throttling an
# unidentified client. Optional; blank means unset, and the User-Agent still
# identifies ScholarLens and its version. No newlines, at most 200 characters.
# ARXIV_CONTACT=
# Optional — where the cached ACL Anthology .bib export lives. Defaults to
# data/acl_anthology_export.bib in code; uncomment only to override.
# ACL_ANTHOLOGY_BIB_PATH=data/acl_anthology_export.bib

# --- GROBID (Stage 2 parsing service) ---
GROBID_URL=http://grobid:8070

# --- Joint NER + relation extraction (Phase 4, all optional) ---
# How many of a paper's text chunks GLiNER2 decodes in one batched call.
# 1 (the default) keeps today's behaviour: one `extract` call per chunk, and a
# chunk that fails is skipped on its own. Above 1 the adapter calls
# `batch_extract` and falls back to per-chunk extraction if the batch raises,
# so the skip-one-chunk contract survives — but beam decoding can break
# near-ties differently at the 0.15/0.05 thresholds, so the entity/relation
# sets are not guaranteed identical. Raise it only after
# `python -m app.core.benchmark nerre` reports set parity on your corpus.
# NERRE_BATCH_SIZE=1

# --- Embeddings & vector indexing (Phase 5) ---
# All optional: the defaults in app/core/config.py are the intended values and
# every variable below only exists so a deployment can override one.
# SPECTER2 = the `allenai/specter2_base` transformer plus the `allenai/specter2`
# *proximity* adapter (the variant the model card prescribes for retrieval and
# clustering). Changing EMBEDDING_MODEL changes the vector dimension, so the
# Qdrant collection must be recreated too — the indexer refuses to write
# mismatched vectors into an existing collection rather than corrupting it.
# EMBEDDING_MODEL=allenai/specter2_base
# EMBEDDING_ADAPTER=allenai/specter2
# Pin both to one Hugging Face revision (commit SHA or tag) for reproducible
# vectors. Unset tracks the model repo's default branch.
# EMBEDDING_MODEL_REVISION=
# Qdrant collection holding every indexed paragraph/limitation/future-work vector.
# QDRANT_COLLECTION=scholarlens_evidence
# Texts per forward pass — the knob that turns corpus size into peak RAM. 1-256.
# EMBEDDING_BATCH_SIZE=16
# Word-piece positions per text; SPECTER2 is BERT-family, so 512 is the ceiling.
# EMBEDDING_MAX_TOKENS=512
# Pre-tokenizer character guard against a pathological paragraph from a bad PDF.
# EMBEDDING_MAX_CHARS=4000
# Sort a paper's records by text length before batching them. Fewer padded
# tokens per forward pass, so Stage 5 encoding gets faster on a corpus with
# uneven paragraph lengths. Point ids and payloads are unchanged, but the
# stored vectors shift by ~1e-6, which can move a borderline HDBSCAN point or
# reorder near-tied retrieval results. Default off: turn it on only after
# running `python -m app.core.benchmark embeddings` and accepting the reported
# padding saving and vector drift.
# EMBEDDING_SORT_BY_LENGTH=false
# Default number of results a semantic query returns when no limit is given.
# RETRIEVAL_TOP_N=12

# --- Interactive GraphRAG (Phase 10, all optional) ---
# Total retrieval rounds including the initial query. README caps this at 3.
# RETRIEVAL_ROUND_CAP=3
# Evidence sufficiency requires both this many chunks and distinct papers.
# RETRIEVAL_MIN_CHUNKS=2
# RETRIEVAL_MIN_PAPERS=2
# Minimum Qdrant/candidate similarity score counted as relevant. Range: 0-1.
# RETRIEVAL_MIN_SCORE=0.2
# Cross-encoder used after vector retrieval + one-hop graph expansion.
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANKER_BATCH_SIZE=16
# Controlled stricter regeneration after grounding failure. Range: 0-1.
# GROUNDING_REGENERATION_CAP=1

# --- Semantic clustering + contradiction detection (Phase 6, all optional) ---
# HDBSCAN discovers how many limitation themes exist from the density of the
# SPECTER2 space. There is deliberately NO cluster-count variable: the number
# of themes is what Stage 6 is trying to find out (CLUSTER-01).
# Smallest group of statements that counts as a theme. 2 is HDBSCAN's floor.
# CLUSTERING_MIN_CLUSTER_SIZE=3
# How conservative HDBSCAN is about calling a point noise. Unset follows
# CLUSTERING_MIN_CLUSTER_SIZE, which is the documented default.
# CLUSTERING_MIN_SAMPLES=
# Shortest statement S6 will cluster. Below this a "limitation" out of a PDF is
# a heading, a caption or a citation fragment ("2023.", "DISCUSSION AND
# LIMITATIONS"). S6 also drops reference entries, bibliography author lists,
# acknowledgements/funding lines and section cross-references before
# clustering; raise or lower this if legitimate short statements are lost.
# CLUSTERING_MIN_STATEMENT_WORDS=6
# Hard cap on gap statements per run: HDBSCAN is O(n^2) in memory.
# CLUSTERING_MAX_STATEMENTS=20000
# DeBERTa-MNLI checkpoint used for pairwise contradiction detection within a
# cluster. `microsoft/deberta-large-mnli` is the larger, slower alternative.
# NLI_MODEL=microsoft/deberta-base-mnli
# Pin the checkpoint to one Hugging Face revision for reproducible flags.
# NLI_MODEL_REVISION=
# Sentence pairs per forward pass. 1-64.
# NLI_BATCH_SIZE=8
# Word-piece budget shared by the premise and hypothesis of a pair. Max 512.
# NLI_MAX_TOKENS=256
# Pre-tokenizer character guard on each side of a pair.
# NLI_MAX_CHARS=1000
# Pairs grow as O(n^2) in cluster size and each one is a transformer forward
# pass; this is what stops one large cluster stalling a corpus run.
# NLI_MAX_PAIRS_PER_CLUSTER=50
# Minimum P(contradiction) before a cross-paper pair is flagged as gap
# evidence. Raising it flags fewer, more confident disagreements.
# CONTRADICTION_THRESHOLD=0.7
#
# What must hold before a pair counts as a disagreement. The NLI model alone
# does not implement "one paper claims a method works where another says it
# fails under the same setup" -- on the LLM-security corpus it scored four
# pairs above P=0.999 in which one side was an ethics disclaimer. These are the
# gates that make it mean that.
#
# Shorter than this a statement is a heading, a caption or a fragment.
# CONTRADICTION_MIN_CLAIM_WORDS=8
# Shared stemmed content terms before two statements count as being about the
# same thing (the four false positives shared 0-1).
# CONTRADICTION_MIN_SHARED_TERMS=3
# ...and that overlap must also be a real share of what either statement says.
# CONTRADICTION_MIN_TOPIC_JACCARD=0.12
# Require both NLI directions to clear the threshold. NLI is asymmetric, so one
# direction alone is as easily an ordering artefact as a disagreement.
# CONTRADICTION_REQUIRE_BOTH_DIRECTIONS=true
# Distinct *paper* pairs that must disagree before a cluster is flagged at all.
# Set to 1 to flag a lone well-corroborated two-paper disagreement, at the cost
# of that being the commonest shape a false positive takes.
# CONTRADICTION_MIN_PAPER_PAIRS=2
# Distinct paper pairs at which the Stage 8 contradiction signal reaches full
# weight; below it the signal is graded pro rata, so one disagreement can no
# longer contribute the whole of GAP_WEIGHT_CONTRADICTION.
# CONTRADICTION_FULL_STRENGTH_PAPER_PAIRS=3

# --- Trend analysis (Phase 7) ---
# Sanity window on publication years. A cluster's time series zero-fills the
# years inside its own observed range, so a single broken year from upstream
# metadata (`12`, `99999`) would otherwise inflate the series to thousands of
# entries and flatten the trend slope. Members dated outside the window are
# dropped exactly like members with no year at all. Both bounds are static on
# purpose: a slope whose value moved with the current date could not be
# reproduced across runs.
# TREND_MIN_YEAR=1900
# TREND_MAX_YEAR=2100

# --- Gap ranking (Phase 8) ---
# The weights in README section 8's gap-score formula:
#
#   gap_score = w1*mention_frequency + w2*trend_slope - w3*solution_density
#             + w4*citation_impact  + w5*contradiction_flag
#
# The signals are raw and in different units (distinct papers, papers per year,
# a ratio in [0,1], mean citations, a 0/1 flag), so these weights are what put
# them on a common scale. Every one must be >= 0 — the formula's own signs
# carry each term's direction, and a negative w3 would turn "this is already
# being solved" into a bonus. Set a weight to 0 to switch its signal off.
#
# One point per paper that mentions the theme: the reference unit.
# GAP_WEIGHT_MENTION_FREQUENCY=1.0
# A theme growing by one paper per year is worth three mentioning papers.
# GAP_WEIGHT_TREND_SLOPE=3.0
# Deliberately large: solution density is a ratio in [0,1] while mention
# frequency is an unbounded count, so a small weight would make the signal that
# says "papers are already addressing this" decorative. Raise it if the ranking
# keeps surfacing well-served themes; this is the weight most worth tuning.
# GAP_WEIGHT_SOLUTION_DENSITY=25.0
# 50 mean citations is worth about one mentioning paper. Only papers matched to
# a Semantic Scholar record carry a citation count; the rest count as unknown.
# GAP_WEIGHT_CITATION_IMPACT=0.02
# A flagged cross-paper disagreement is worth five mentioning papers.
# GAP_WEIGHT_CONTRADICTION=5.0
# How many of a cluster label's stemmed terms a paper's contribution must share
# before that paper counts as working on the theme. Two, not all of them:
# requiring every term scored 0.00 for every cluster in the corpus, because a
# label like "prompt attacks injection" appears verbatim in no contribution.
# GAP_SOLUTION_MIN_LABEL_OVERLAP=2

# --- Mode A RAG explanation (Phase 9, all optional) ---
# How many of the top-ranked gaps get an LLM-generated report. One LLM call
# each, so this is what bounds generation cost per pipeline run — and it is the
# first thing to lower if Groq keeps metering the run (see GROQ_MIN_INTERVAL_
# SECONDS below for the alternative that keeps all K reports). Below about 3
# the dashboard stops being a gap *report* and becomes a single example.
# REPORT_TOP_K=5
# Supporting passages retrieved from Qdrant per gap. This is the report's whole
# evidence budget and its whole prompt budget.
# REPORT_EVIDENCE_TOP_N=8
# How many passages one paper may contribute to a single report. Stage 9 used
# to take whatever Qdrant ranked highest, which for the corpus's top gap meant
# 7 of 8 passages from one study.
# REPORT_EVIDENCE_PER_PAPER_CAP=3
# How much wider than REPORT_EVIDENCE_TOP_N retrieval reaches before the cap
# and the cluster-paper preference select from it. With no headroom the cap can
# only remove evidence, never promote a crowded-out paper.
# REPORT_EVIDENCE_OVERSAMPLE=4

# --- LLM (consumed starting Phase 9/10 — Mode A explanation / Mode B GraphRAG) ---
# Groq is the only supported provider. This exists so a wrong value fails
# loudly with a clear message instead of being silently ignored.
# LLM_PROVIDER=groq
# Generic provider credential. GROQ_API_KEY takes precedence when set.
LLM_API_KEY=
# Seconds before a generation request is abandoned.
# LLM_TIMEOUT_SECONDS=120

# Groq — create a key at https://console.groq.com/keys and paste it here.
# Nothing else in the project needs changing; the backend picks it up on
# restart. Required before Mode A report generation or Mode B queries can run.
GROQ_API_KEY=
# Must be a Groq model that supports `response_format: json_schema` (the
# gpt-oss and qwen3.8 families do). On any other model Stage 9's report schema
# can only be requested in the prompt, not enforced by the provider.
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_API_URL=https://api.groq.com/openai/v1

# --- Groq rate limiting (Phase 9/10, all optional) ---
# Groq meters tokens per minute as well as requests per day, and Stage 9 sends
# REPORT_TOP_K generations back to back. These are what let a run ride out a
# 429 instead of failing on it. A rate-limited run never damages the evidence
# base: retry report generation on its own with `POST /reports`.
#
# Retries of a 429/5xx answer, on top of the first attempt. 0 fails fast.
# GROQ_MAX_RETRIES=4
# First backoff step; each further retry doubles it. A longer Retry-After from
# Groq always wins over this.
# GROQ_BACKOFF_BASE_SECONDS=2
# The longest wait one request will absorb. Above 60 on purpose: a per-minute
# ceiling clears within the minute. A daily quota asks for hours, exceeds this,
# and is reported rather than slept on.
# GROQ_BACKOFF_MAX_SECONDS=90
# Proactive spacing between Groq requests, process-wide (Stage 9 and /query
# share it). 0 means "send as fast as work arrives and rely on retries", which
# suits a paid tier. On a free tier whose tokens-per-minute a burst of
# REPORT_TOP_K reports exceeds, set this to roughly
#   60 / (TPM limit / tokens per report)
# — e.g. 8000 TPM and ~4000 tokens per report gives one request per 30s. This
# is how you keep all K reports instead of lowering REPORT_TOP_K.
# GROQ_MIN_INTERVAL_SECONDS=0
# Ceiling on the tokens one generation may produce. The default model reasons
# before it answers and those hidden tokens are metered too, so uncapped, one
# report's spend against the per-minute ceiling is unbounded. Raise it if
# reports come back reported as truncated.
# GROQ_MAX_COMPLETION_TOKENS=2048

# --- Backend API authentication (Phase 11) ---
# Shared secret every caller must present as an `X-API-Key` request header
# (README §12). The dashboard asks for this same value under "Connect API".
# `GET /health` is intentionally exempt so container health probes work.
# Distinct from LLM_API_KEY above, which authenticates ScholarLens *to* an
# LLM provider. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If this is unset or blank the API fails closed — every authenticated
# endpoint returns 500 rather than silently allowing anonymous access.
API_KEY=change_me_generate_a_random_value
